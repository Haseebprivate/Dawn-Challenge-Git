{% if shop.metafields.custom.sale_is_live.value %}
  {% assign discount = shop.metafields.custom.discount_percentage.value %}

  {% assign discount_amount = product.selected_or_first_available_variant.price | times: discount | divided_by: 100 %}
  {% assign discounted_price = product.selected_or_first_available_variant.price | minus: discount_amount %}

  <div class="custom-sale-price">
    <s>
      <span class="custom-original-price__amount">
        {{ product.selected_or_first_available_variant.price | money }}
      </span>
    </s>

    <span class="custom-discounted-price__amount">
      {{ discounted_price | money }}
    </span>
  </div>
{% endif %}

<style>
  .custom-sale-price {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    background: #fffdf5;
    border: 1px solid #f4e08a;
    border-radius: 12px;
  }

  .custom-original-price__amount {
    font-size: 1.8rem;
    font-weight: 600;
    color: #777;
    text-decoration: line-through;
  }

  .custom-discounted-price__amount {
    font-size: 2.2rem;
    font-weight: 700;
    color: #d32f2f;
  }

  /* Optional labels if you add them */
  .custom-price__text,
  .custom-discounted-price__text {
    font-size: 1.3rem;
    font-weight: 600;
    color: #666;
  }

  .custom-discount {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0.45rem 0.9rem;

    background: linear-gradient(135deg, #ffd54f, #ffca28);
    color: #111;

    font-size: 1.3rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;

    border-radius: 999px;

    box-shadow: 0 3px 10px rgba(255, 193, 7, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.45);

    animation: badgePulse 2s ease-in-out infinite;
  }

  @keyframes badgePulse {
    0%,
    100% {
      transform: scale(1);
    }

    50% {
      transform: scale(1.06);
    }
  }

  .estimated-delivery {
    display: flex;
    align-items: center;
    gap: 0.75rem;

    margin-top: 1.5rem;
    padding: 1rem;

    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: 0.8rem;

    font-size: 1.4rem;
  }

  .estimated-delivery__icon {
    font-size: 2rem;
  }

  .estimated-delivery strong {
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .custom-sale-price {
      gap: 0.5rem;
      padding: 0.9rem 1rem;
    }

    .custom-original-price__amount {
      font-size: 1.6rem;
    }

    .custom-discounted-price__amount {
      font-size: 2rem;
    }

    .custom-discount {
      font-size: 1.2rem;
      padding: 0.35rem 0.75rem;
    }
  }
</style>
